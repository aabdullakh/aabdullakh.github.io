---
import { Image } from 'astro:assets';
import type { ProjectEntry } from '../lib/content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, toISODate } from '../lib/dates';

interface Props {
  entry: ProjectEntry;
  Content: any;
}

const { entry, Content } = Astro.props;
const { title, description, date, tags, cover, coverAlt, repoUrl, liveUrl } = entry.data;
---

<BaseLayout title={title} description={description} image={cover?.src} article>
  <article class="prose">
    <a class="back-link meta" href="/projects/">&larr; Projects</a>
    <h1>{title}</h1>
    <p class="meta entry-meta">
      <time datetime={toISODate(date)}>{formatDate(date)}</time>
    </p>
    {
      tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
    <p class="project-links">
      {repoUrl && <a href={repoUrl}>Code &rarr;</a>}
      {repoUrl && liveUrl && <span aria-hidden="true"> · </span>}
      {liveUrl && <a href={liveUrl}>Live &rarr;</a>}
    </p>

    {
      cover && (
        <figure class="cover-figure">
          <Image src={cover} alt={coverAlt ?? ''} width={920} height={517} />
          {coverAlt && <figcaption>{coverAlt}</figcaption>}
        </figure>
      )
    }

    <div class="numbered-headings entry-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    text-decoration: none;
    margin-bottom: var(--space-3);
  }

  .entry-meta {
    margin-top: var(--space-2);
  }

  .project-links {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .project-links a {
    text-decoration: none;
    color: var(--color-accent);
  }

  .cover-figure {
    margin-top: var(--space-5);
  }

  .cover-figure img {
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }

  .entry-body {
    margin-top: var(--space-5);
  }
</style>
