---
const year = new Date().getFullYear();
// Astro replaces this at build time with the commit-independent build date,
// which doubles as an honest "last updated" for a mostly-static site.
const lastUpdated = new Date();
---

<footer class="site-footer">
  <div class="wrapper footer-inner">
    <ul class="footer-links">
      <li><a href="https://github.com/aabdullakh">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/abdullahabs/">LinkedIn</a></li>
      <li><a href="mailto:abdullah.abshukur@gmail.com">Email</a></li>
    
    </ul>
   <p class="footer-meta">
  © {new Date().getFullYear()} Abdullakh Abshukur
</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
  }

.footer-inner {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  text-align: center;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1.25rem;
}

  .footer-links a {
    text-decoration: none;
    color: var(--color-ink-soft);
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

 .footer-meta {
  font-size: 0.875rem;
  opacity: 0.7;
}

  .footer-meta a {
    color: inherit;
  }
</style>
