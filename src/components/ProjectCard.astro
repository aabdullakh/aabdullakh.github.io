---
import { Image } from 'astro:assets';
import type { ProjectEntry } from '../lib/content';

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const { title, description, tags, cover, coverAlt, repoUrl, liveUrl } = entry.data;
---

<article class="project-card">
  <a class="cover-link" href={`/projects/${entry.id}/`}>
    {
      cover ? (
        <Image src={cover} alt={coverAlt ?? ''} width={480} height={270} class="cover" />
      ) : (
        <span class="cover cover-placeholder" aria-hidden="true">
          {'</>'}
        </span>
      )
    }
  </a>
  <div class="project-body">
    <a class="project-link" href={`/projects/${entry.id}/`}>
      <h3>{title}</h3>
    </a>
    <p class="description">{description}</p>
    {
      tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
    <p class="project-links">
      {repoUrl && <a href={repoUrl}>Code</a>}
      {repoUrl && liveUrl && <span aria-hidden="true"> · </span>}
      {liveUrl && <a href={liveUrl}>Live</a>}
    </p>
  </div>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease;
  }

  .project-card:hover {
    border-color: var(--color-accent-soft);
  }

  .cover-link {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-raised);
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--color-accent-soft);
  }

  .project-body {
    padding: var(--space-3);
  }

  .project-link {
    text-decoration: none;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .project-link:hover h3 {
    color: var(--color-accent);
  }

  .description {
    margin-top: var(--space-2);
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .project-links {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .project-links a {
    text-decoration: none;
    color: var(--color-accent);
  }
</style>
