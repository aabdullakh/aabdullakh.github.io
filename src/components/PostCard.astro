---
import type { JournalEntry } from '../lib/content';
import { formatDate, toISODate } from '../lib/dates';

interface Props {
  entry: JournalEntry;
}

const { entry } = Astro.props;
const { title, date, description, tags } = entry.data;
---

<article class="post-card">
  <a class="post-link" href={`/journal/${entry.id}/`}>
    <h3>{title}</h3>
  </a>
  <p class="meta"><time datetime={toISODate(date)}>{formatDate(date)}</time></p>
  <p class="description">{description}</p>
  {
    tags.length > 0 && (
      <ul class="tag-list">
        {tags.map((tag) => (
          <li>
            <a class="tag" href={`/journal/tag/${tag}/`}>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card + .post-card {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .post-link {
    text-decoration: none;
  }

  .post-card h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .post-link:hover h3 {
    color: var(--color-accent);
  }

  .description {
    margin-top: var(--space-2);
    color: var(--color-ink-soft);
  }
</style>
