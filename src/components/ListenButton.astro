---
// "Listen to this post": plays narration made ahead of time by
// scripts/audio/generate.mjs (Kokoro, an open-source text-to-speech model).
// Because the MP3 already exists, it plays straight through on any device,
// with no model download. While it plays, the paragraph being read is highlighted.
//
// If a post has no audio yet (e.g. local dev without `npm run audio`), nothing renders.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const manifestPath = path.join(process.cwd(), 'src/data/audio.json');
const manifest = fs.existsSync(manifestPath) ? JSON.parse(fs.readFileSync(manifestPath, 'utf8')) : {};
const entry = manifest[slug] as { src: string; duration: number; blocks: { t: number; k: string }[] } | undefined;

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
---

{
  entry && (
    <div class="listen" data-listen data-blocks={JSON.stringify(entry.blocks)}>
      <audio preload="none" src={entry.src} data-listen-audio />
      <button type="button" class="listen-btn" data-listen-play aria-label="Listen to this post">
        <svg class="icon icon-play" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" fill="currentColor" />
        </svg>
        <svg class="icon icon-pause" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" />
        </svg>
        <span data-listen-label>Listen</span>
      </button>
      <input
        class="listen-seek"
        type="range"
        min="0"
        max={entry.duration}
        step="1"
        value="0"
        aria-label="Seek"
        data-listen-seek
      />
      <span class="meta listen-time" data-listen-time>
        {fmt(entry.duration)}
      </span>
      <label class="listen-option meta">
        <span class="visually-hidden">Speed</span>
        <select data-listen-speed aria-label="Speed">
          <option value="1">1×</option>
          <option value="1.25">1.25×</option>
          <option value="1.5">1.5×</option>
          <option value="1.75">1.75×</option>
          <option value="2">2×</option>
        </select>
      </label>
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-listen]');
  const body = document.querySelector<HTMLElement>('.entry-body');
  if (root && body) setup(root, body);

  function setup(root: HTMLElement, body: HTMLElement) {
    const audio = root.querySelector<HTMLAudioElement>('[data-listen-audio]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-listen-play]')!;
    const label = root.querySelector<HTMLElement>('[data-listen-label]')!;
    const seek = root.querySelector<HTMLInputElement>('[data-listen-seek]')!;
    const time = root.querySelector<HTMLElement>('[data-listen-time]')!;
    const speed = root.querySelector<HTMLSelectElement>('[data-listen-speed]')!;
    const blocks: { t: number; k: string }[] = JSON.parse(root.dataset.blocks || '[]');
    const total = Number(seek.max);

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    try {
      speed.value = localStorage.getItem('tts-speed') || '1';
    } catch {}

    // ---- Match each spoken block to its element on the page ----
    // The generator stores the first 40 letters/digits of every block; the same
    // key is computed here from the page, then matched in reading order.
    const key = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 40);
    const skip = 'pre, table, nav, figure, .sidenote, .katex, .toc';
    const candidates = [...body.querySelectorAll('h2, h3, h4, p, li')].filter((el) => !el.closest(skip));
    const textOf = (el: Element) => {
      const c = el.cloneNode(true) as Element;
      c.querySelectorAll('.sidenote, .sidenote-number, .katex, sup, ul, ol').forEach((n) => n.remove());
      return c.textContent || '';
    };
    const keys = candidates.map((el) => key(textOf(el)));
    let cursor = 0;
    const blockEls: (Element | null)[] = blocks.map((b) => {
      for (let j = cursor; j < candidates.length; j++) {
        if (keys[j] && (keys[j].startsWith(b.k) || b.k.startsWith(keys[j]))) {
          cursor = j + 1;
          return candidates[j];
        }
      }
      return null;
    });

    let highlighted: Element | null = null;
    function highlight(el: Element | null) {
      if (el === highlighted) return;
      highlighted?.classList.remove('tts-reading');
      el?.classList.add('tts-reading');
      highlighted = el;
    }

    function currentBlock(t: number): Element | null {
      let lo = -1;
      for (let i = 0; i < blocks.length && blocks[i].t <= t; i++) lo = i;
      return lo >= 0 ? blockEls[lo] : null;
    }

    // ---- Player ----
    function render() {
      const playing = !audio.paused && !audio.ended;
      root.dataset.state = playing ? 'playing' : audio.currentTime > 0 && !audio.ended ? 'paused' : 'idle';
      label.textContent = playing ? 'Pause' : root.dataset.state === 'paused' ? 'Resume' : 'Listen';
      playBtn.setAttribute('aria-label', label.textContent);
      const t = audio.currentTime;
      seek.value = String(t);
      seek.style.setProperty('--progress', `${(t / total) * 100}%`);
      time.textContent = t > 0 ? `${fmt(t)} / ${fmt(total)}` : fmt(total);
      highlight(t > 0 && !audio.ended ? currentBlock(t) : null);
    }

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.playbackRate = Number(speed.value);
        audio.play();
      } else audio.pause();
    });

    seek.addEventListener('input', () => {
      audio.currentTime = Number(seek.value);
      render();
    });

    speed.addEventListener('change', () => {
      audio.playbackRate = Number(speed.value);
      try {
        localStorage.setItem('tts-speed', speed.value);
      } catch {}
    });

    // Click a highlighted-able paragraph while listening to jump there.
    body.addEventListener('click', (e) => {
      if (root.dataset.state === 'idle') return;
      const el = (e.target as Element).closest('h2, h3, h4, p, li');
      if (!el || (e.target as Element).closest('a, button, input, label')) return;
      const i = blockEls.indexOf(el);
      if (i >= 0) {
        audio.currentTime = blocks[i].t;
        render();
      }
    });

    audio.addEventListener('play', render);
    audio.addEventListener('pause', render);
    audio.addEventListener('timeupdate', render);
    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      render();
    });
    audio.addEventListener('ratechange', () => (speed.value = String(audio.playbackRate)));

    // Lock-screen / headphone controls on phones.
    if ('mediaSession' in navigator) {
      audio.addEventListener('play', () => {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: document.querySelector('article h1')?.textContent?.trim() || document.title,
          artist: 'Abdullakh Abshukur',
        });
      });
    }
  }
</script>

<style>
  .listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
  }

  .listen-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    height: 2rem;
    padding: 0 0.85em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .listen-btn:hover,
  [data-state='playing'] .listen-btn {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .icon-pause,
  [data-state='playing'] .icon-play {
    display: none;
  }

  [data-state='playing'] .icon-pause {
    display: block;
  }

  .listen-seek {
    flex: 1 1 8rem;
    min-width: 6rem;
    height: 2rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
    --progress: 0%;
  }

  .listen-seek::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(to right, var(--color-accent) var(--progress), var(--color-border) var(--progress));
  }

  .listen-seek::-moz-range-track {
    height: 3px;
    border-radius: 3px;
    background: var(--color-border);
  }

  .listen-seek::-moz-range-progress {
    height: 3px;
    border-radius: 3px;
    background: var(--color-accent);
  }

  .listen-seek::-webkit-slider-thumb {
    appearance: none;
    width: 11px;
    height: 11px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .listen-seek::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .listen-time {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .listen-option select {
    height: 2rem;
    padding: 0 0.5em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    font: inherit;
    cursor: pointer;
  }

  .listen-option select option {
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The paragraph currently being read. Global, since it targets post content. */
  :global(.tts-reading) {
    background: var(--color-selection);
    border-radius: var(--radius);
    box-shadow: 0 0 0 0.25em var(--color-selection);
    transition: background 0.2s ease;
  }

  @media print {
    .listen {
      display: none;
    }
  }
</style>
