---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, uniqueTags } from '../../lib/content';

const projects = await getProjects();
const tags = uniqueTags(projects);
---

<BaseLayout title="Projects" description="Things I've built.">
  <div class="wrapper">
    <h1>Things I've built</h1>
    <p>A mix of school projects, weekend experiments, and things I built because I was curious.</p>

    {
      tags.length > 0 && (
        <div class="filter-buttons" role="group" aria-label="Filter projects by tag">
          <button type="button" class="filter-btn is-active" data-filter="all">
            All
          </button>
          {tags.map((tag) => (
            <button type="button" class="filter-btn" data-filter={tag}>
              {tag}
            </button>
          ))}
        </div>
      )
    }

    <div class="project-grid" id="project-grid">
      {
        projects.map((entry) => (
          <div class="project-cell" data-tags={entry.data.tags.join(',')}>
            <ProjectCard entry={entry} />
          </div>
        ))
      }
    </div>

    {projects.length === 0 && <p>Nothing here yet — check back soon.</p>}
  </div>
</BaseLayout>

<style>
  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3em 0.9em;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-btn.is-active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .project-cell[hidden] {
    display: none;
  }
</style>

<script>
  // Client-side tag filtering — small enough not to need a page reload or a
  // separate /projects/tag/[tag] route the way the journal has.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cells = document.querySelectorAll<HTMLDivElement>('.project-cell');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';

      for (const other of buttons) other.classList.toggle('is-active', other === button);

      for (const cell of cells) {
        const tags = (cell.dataset.tags ?? '').split(',');
        cell.hidden = filter !== 'all' && !tags.includes(filter);
      }
    });
  }
</script>
